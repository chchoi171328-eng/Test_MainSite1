# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Admin Configuration
NEXT_PUBLIC_ADMIN_EMAIL=admin@sllaw.co.kr

# EmailJS Configuration (상담 접수 서버 발송용)
# 서버 전용 변수를 권장 (클라이언트 번들에 포함되지 않음).
# 기존 NEXT_PUBLIC_EMAILJS_* 값이 있으면 폴백으로 사용된다.
# EMAILJS_SERVICE_ID=your_service_id
# EMAILJS_TEMPLATE_ID=your_template_id
# EMAILJS_PUBLIC_KEY=your_public_key
# EmailJS 대시보드에서 "Allow API for non-browser applications"를 켜거나 아래 Private Key를 설정
# EMAILJS_PRIVATE_KEY=your_private_key

# Site / SEO Configuration
# 정식 도메인 연결 시 실제 도메인으로 변경 (예: https://www.sllaw.co.kr)
NEXT_PUBLIC_SITE_URL=https://test-main-site1.vercel.app
# 정식 도메인에서만 true로 설정 - true가 아니면 전체 noindex + robots.txt 수집 차단
NEXT_PUBLIC_ALLOW_INDEXING=false

# Search Engine Verification (optional)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_verification_code
# NEXT_PUBLIC_NAVER_SITE_VERIFICATION=your_naver_verification_code

# Google Analytics 4 (optional) - 미설정 시 분석 코드 완전 비활성
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
